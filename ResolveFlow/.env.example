# ResolveFlow 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=ResolveFlow
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM（唯一一套配置，主 Agent/RAG 链路和下面的 Action GoalInterpreter 共用）───────
# provider 决定用哪种协议调用：
#   anthropic（默认，不用填）= Claude 官方，或 DeepSeek 这类 Anthropic Messages API 兼容服务
#   openai                  = Qwen(DashScope)、以及任何 OpenAI Chat Completions 兼容服务
# LLM_PROVIDER=anthropic

LLM_API_KEY=your_api_key_here

# 可选：换成兼容 Anthropic 协议的第三方服务（如 DeepSeek）时才需要
# LLM_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# LLM_MODEL=deepseek-v4-pro

# ── 使用 Qwen（DashScope）示例 ──────────────────────────────────────────────────
# 名字虽然叫 LLM_*，但走的是 OpenAI Chat Completions 兼容协议，同样适用于任何
# OpenAI 兼容服务，不只是 Qwen。
# LLM_PROVIDER=openai
# LLM_API_KEY=your_dashscope_api_key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 国际账号请使用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Qwen3 专用 Reranker ──────────────────────────────────────────────────────
# qwen3-rerank 使用百炼业务空间域名。API Key 默认依次复用
# QWEN_RERANK_API_KEY、DASHSCOPE_API_KEY、LLM_API_KEY，无需重复填写。
# DASHSCOPE_WORKSPACE_ID=your_workspace_id
# DASHSCOPE_REGION=cn-beijing
# 或直接填写完整地址（以 /compatible-api/v1 或 /reranks 结尾）：
# QWEN_RERANK_BASE_URL=https://your_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-api/v1
# QWEN_RERANK_MODEL=qwen3-rerank
# QWEN_RERANK_TIMEOUT_SECONDS=5
# QWEN_RERANK_MAX_RETRIES=1
# QWEN_RERANK_MAX_DOCUMENT_CHARS=12000

# ── Action Runtime / GoalInterpreter ─────────────────────────────────────────
# 订阅售后这类"受控执行"链路（查询/修复权益、退款、取消续费等）用的是独立的
# ActionRuntime + GoalInterpreter，鉴权和是否用 LLM 解析目标由下面几个变量控制,
# 但真正调用 LLM 时用的就是上面同一套 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL /
# LLM_PROVIDER —— 不需要再配一份。

# JWT 签名密钥：签发/校验 /agent/auth/token 发的用户、审核员、管理员 token。
# 必填，且要用一个随机字符串（例如 python3 -c "import secrets; print(secrets.token_hex(32))"）。
AGENT_JWT_SECRET=change_this_to_a_random_secret

# 铸造 token 的根密钥：请求 /agent/auth/token 时通过 X-Admin-Secret 请求头提供，
# 不是 JWT，是唯一的非 JWT 信任锚点。同样建议用随机字符串。
AGENT_ADMIN_SECRET=change_this_to_a_random_secret

# GoalInterpreter 是否用 LLM 把自然语言解析成结构化目标：
#   0（默认）= 用离线规则（offline_rules），不调用任何 LLM，适合跑测试/离线体验状态机
#   1        = 用上面的 LLM_* 配置真正调用模型解析
AGENT_USE_LLM=0

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=resolveflow123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
RESOLVEFLOW_SKILLS_DIR=./skills
RESOLVEFLOW_SKILLS_MAX_PROMPT_CHARS=5000

# ── Multi-Agent Supervisor ───────────────────────────────────────────────────
SUPERVISOR_MAX_SUBTASKS=3
SUPERVISOR_SUBTASK_TIMEOUT_SECONDS=30

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
